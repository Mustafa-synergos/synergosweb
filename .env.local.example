NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_TOKEN=

# Public base URL for CMS uploads / images (CDN or Strapi public URL)
# Falls back to NEXT_PUBLIC_STRAPI_API_URL when unset
NEXT_PUBLIC_MEDIA_URL=http://localhost:1337

# Server-only token used by /api/contact to save submissions in Strapi
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# On-demand cache revalidation (must match backend REVALIDATE_SECRET)
REVALIDATE_SECRET=

# Draft preview (must match backend PREVIEW_SECRET)
PREVIEW_SECRET=
